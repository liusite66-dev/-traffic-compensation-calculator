{
  "name": "traffic-compensation-calculator",
  "version": "1.0.0",
  "description": "交通事故赔偿计算器",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "pack": "electron-builder --dir"
  },
  "build": {
    "appId": "com.traffic.compensation",
    "productName": "交通事故赔偿计算器",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "files": [
      "index.html",
      "main.js",
      "exceljs.min.js"
    ]
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "electron": "^42.3.0",
    "electron-builder": "^26.8.1"
  }
}
